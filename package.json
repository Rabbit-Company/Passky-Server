{
	"name": "passky-server",
	"version": "10.0.0",
	"description": "Server for Passky (password manager)",
	"module": "index.ts",
	"type": "module",
	"scripts": {
		"start": "bun run server/index.ts",
		"test": "bun test",
		"watch": "bun --watch server/index.ts",
		"build": "bun build server/index.ts --compile --minify --outfile ./passky-server"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Rabbit-Company/Passky-Server.git"
	},
	"keywords": [
		"passky",
		"password",
		"manager",
		"security"
	],
	"author": "Rabbit Company",
	"license": "GPL-3.0",
	"bugs": {
		"url": "https://github.com/Rabbit-Company/Passky-Server/issues"
	},
	"homepage": "https://github.com/Rabbit-Company/Passky-Server#readme",
	"devDependencies": {
		"@types/bun": "^1.3.3"
	},
	"dependencies": {
		"@rabbit-company/openmetrics-client": "^2.0.1",
		"@rabbit-company/password-generator": "^2.2.0",
		"@rabbit-company/totp": "^1.0.1",
		"@rabbit-company/web": "^0.16.0",
		"@rabbit-company/web-middleware": "^0.16.0"
	}
}
