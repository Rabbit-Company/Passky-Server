#
# SERVER SETTINGS
#

# In what country your Passky Server is hosted?
# Only "ISO 3166-1 alpha-2" codes are accepted. (https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2#Officially_assigned_code_elements)
SERVER_LOCATION=US

# How many cores / threads does your server have?
SERVER_CORES=1

# Bind address and port inside the container.
SERVER_HOST=0.0.0.0
SERVER_PORT=80

# Comma-separated proxy IP addresses or CIDR ranges allowed to supply client IP headers.
# When empty, loopback and private networks (Docker, LAN reverse proxies) are trusted.
# Set to "none" when Passky receives connections directly from the internet.
TRUSTED_PROXIES=

# Origin signing secret from BurrowGate's site editor. When set, only requests
# signed by BurrowGate are accepted and the client IP is taken from the signature.
BURROWGATE_ORIGIN_SECRET=

#
# ADMIN SETTINGS
#

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_TTL=3600

#
# CLOUDFLARE CAPTCHA
#

CF_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CF_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

#
# DATABASE SETTINGS
# DATABASE_URL takes precedence when provided. Supported schemes are
# sqlite://, mysql:// (also MariaDB), postgres:// and postgresql://.
DATABASE_URL=

DATABASE_ENGINE=sqlite
DATABASE_FILE=passky

MYSQL_HOST=passky-database
MYSQL_PORT=3306
MYSQL_DATABASE=passky
MYSQL_USER=passky
MYSQL_PASSWORD=

MYSQL_SSL=false
MYSQL_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# How long getInfo caches the user and password counts.
# 0 or 1: one minute. 2 or higher: twelve hours (recommended for databases billed by rows read).
MYSQL_CACHE_MODE=0

# New accounts use Argon2id. Older bcrypt hashes are upgraded after a
# successful login. Parameters are encoded into each Argon2id hash.
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3

#
# REDIS SETTINGS (optional)
#
# Redis keeps sign-in tokens across restarts. Without it, tokens are kept in memory.
# Use REDIS_URL (redis:// or rediss://), or REDIS_HOST with tls:// for TLS connections.

REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

#
# MAIL SETTINGS
#

# Provide SMTP credentials
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true

#
# ACCOUNT SETTINGS
#

# How many accounts can be created on this server.
ACCOUNT_MAX=100
# How many passwords can each account have.
ACCOUNT_MAX_PASSWORDS=1000
# How many passwords can premium account have. (-1 indicates unlimited)
ACCOUNT_PREMIUM=-1

#
# YUBICO SETTINGS
#

# If you want to self host YubiCloud you can change this URL to your own.
YUBI_CLOUD=https://api.yubico.com/wsapi/2.0/verify
# You can use our ID, or create your own here: https://upgrade.yubico.com/getapikey/
YUBI_ID=67857

#
# API CALL LIMITER (Brute force mitigation)
#	Values are in seconds
#

LIMITER_ENABLED=true

LIMITER_GET_INFO=-1
LIMITER_GET_STATS=-1
LIMITER_GET_TOKEN=3
LIMITER_GET_PASSWORDS=2
LIMITER_SAVE_PASSWORD=2
LIMITER_EDIT_PASSWORD=2
LIMITER_DELETE_PASSWORD=2
LIMITER_DELETE_PASSWORDS=10
LIMITER_CREATE_ACCOUNT=10
LIMITER_DELETE_ACCOUNT=10
LIMITER_IMPORT_PASSWORDS=10
LIMITER_FORGOT_USERNAME=60
LIMITER_ENABLE_2FA=10
LIMITER_DISABLE_2FA=10
LIMITER_ADD_YUBIKEY=10
LIMITER_REMOVE_YUBIKEY=10
LIMITER_UPGRADE_ACCOUNT=10
LIMITER_GET_REPORT=-1

#
# OBSERVABILITY
#

METRICS_ENABLED=false
# Set a token to protect /metrics with Bearer authentication.
METRICS_TOKEN=

# Publicly exposes /?action=getReport (daily registration and active user counts).
# The report is always visible to signed-in administrators regardless of this setting.
REPORTS_ENABLED=false

LOG_PRESET=standard
LOKI_URL=
LOKI_USERNAME=
LOKI_PASSWORD=
